# EvidenceGraph AI - example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Database
DATABASE_URL=sqlite:///data/evidencegraph.db

# LLM provider (any OpenAI-compatible chat completions endpoint)
# Set LLM_PROVIDER=mock for offline runs (no API key needed).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.0

# Retrieval
RETRIEVAL_TOP_K=4

# Cost estimation (Stage 2.8). OPTIONAL and off by default. Set BOTH prices
# (USD per million tokens, from your provider's current price list) before
# any cost is estimated; cost is only ever computed from provider-reported
# token counts, never guessed. Leave both unset to report cost as
# "unavailable" -- the honest default. Self-hosted models (e.g. Ollama) have
# no per-token API charge, so leave these unset for them too.
#LLM_PRICE_INPUT_PER_MILLION=
#LLM_PRICE_OUTPUT_PER_MILLION=

# Chunking (used by every ingest path, fixture and live)
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150

# Fetching public feeds (Phase 1). No key is required to run tests: the
# whole suite is offline and uses httpx.MockTransport.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.0
HTTP_BACKOFF_MAX_SECONDS=30.0
HTTP_MAX_RETRY_AFTER_SECONDS=60.0

# CISA KEV catalog (static JSON, no auth, CC0 1.0)
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# NVD API 2.0 (optional key raises the limit from 5 to 50 requests/30s;
# leave empty to stay on the public limit. The key is sent in the `apiKey`
# request header and is never printed or committed.)
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
# Seconds between NVD requests. Leave unset to auto-select (6s without a
# key, 1s with one) in line with NIST's published rate-limit guidance.
#NVD_MIN_REQUEST_INTERVAL_SECONDS=
